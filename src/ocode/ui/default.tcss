/* ocode default theme (M1 editor) */
Screen {
    background: #1e1e2e;
    color: #cdd6f4;
}

#sidebar {
    background: #181825;
    border-right: solid #45475a;
    width: 28;
}

#editor-area {
    background: #1e1e2e;
}

#tabbar {
    background: #181825;
    color: #a6adc8;
    height: 1;
}

#breadcrumb {
    background: #1e1e2e;
    color: #89b4fa;
    height: 1;
}

#logs {
    background: #11111b;
    border-top: solid #45475a;
    height: 10;
}

#logs.hidden {
    display: none;
}

#editor {
    background: #1e1e2e;
    height: 1fr;
}

#findbar {
    background: #313244;
    height: auto;
    display: none;
}

#findbar.visible {
    display: block;
}

#statusbar {
    background: #313244;
    color: #cdd6f4;
    height: 1;
}
